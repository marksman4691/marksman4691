{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost",
  "Bridge": {
    "Url": "http://127.0.0.1:9123",
    "AllowedOrigins": [
      "https://your-web-app.example.com",
      "http://localhost:5173"
    ],
    "AllowRequestsWithoutOrigin": true,
    "ApiKey": "",
    "Driver": "Mock",
    "DefaultScanTimeoutMs": 30000,
    "MaxScanTimeoutMs": 120000,
    "MaxBatchItems": 100,
    "Requirements": {
      "RequireBack": true,
      "RequireMicr": true
    },
    "Image": {
      "Dpi": 200,
      "ByteOrder": "LittleEndian",
      "MinWidthInches": 4.5,
      "MaxWidthInches": 9.5,
      "MinHeightInches": 2.0,
      "MaxHeightInches": 4.5,
      "MinBlackRatio": 0.005,
      "MaxBlackRatio": 0.25,
      "PreviewMaxWidth": 800
    },
    "Opos": {
      "CheckScannerProgId": "OPOS.CheckScanner",
      "LogicalName": "CheckScanner",
      "ClaimTimeoutMs": 3000,
      "InsertionPollMs": 1000,
      "RemovalTimeoutMs": 5000
    },
    "Mock": {
      "InsertionDelayMs": 1500,
      "PerItemDelayMs": 400,
      "ItemsInHopper": 3,
      "Dpi": 300
    }
  }
}
